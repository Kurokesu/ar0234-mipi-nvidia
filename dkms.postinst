#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# Copyright (c) 2026, UAB Kurokesu. All rights reserved.
#
# DKMS post-install script: build and install device tree overlays.

set -e

# Status line formatter (matches Makefile's PRINT)
print() { printf '  %-7s %s\n' "$1" "$2"; }

cd "$(dirname "$0")"
DKMS_SRC="$(pwd)"

DTS_FILES=$(ls ./*.dts)

KERNEL_INCLUDE="/usr/src/linux-headers-$(uname -r | sed 's/-tegra.*/-tegra-ubuntu22.04_aarch64/')/3rdparty/canonical/linux-jammy/kernel-source/include"
LOCAL_INCLUDE="$DKMS_SRC/include"
NV_TEGRA_RELEASE="/etc/nv_tegra_release"

# Patch to "Jetson 24pin CSI Connector" for L4T < 36.5 (JetPack 6.2.2).
read -r NV_RELEASE_STR < "$NV_TEGRA_RELEASE"
if [[ "$NV_RELEASE_STR" =~ R([0-9]+).*REVISION:\ *([0-9]+) ]]; then
	L4T_MAJOR="${BASH_REMATCH[1]}"
	L4T_MINOR="${BASH_REMATCH[2]}"
else
	echo "ERROR: cannot parse $NV_TEGRA_RELEASE" >&2; exit 1
fi

for DTS in $DTS_FILES; do
	DTBO="${DTS%.dts}.dtbo"
	PREPROCESSED="/tmp/${DTS##*/}.preprocessed"

	print CPP "$DTS"
	cpp -nostdinc -undef -D__DTS__ -x assembler-with-cpp \
		-I"$LOCAL_INCLUDE" -I"$KERNEL_INCLUDE" \
		-o "$PREPROCESSED" "$DKMS_SRC/$DTS"

	if [ $((L4T_MAJOR * 100 + L4T_MINOR)) -lt 3605 ]; then
		print PATCH "jetson-header-name -> 24pin (L4T ${L4T_MAJOR}.${L4T_MINOR})"
		sed -i 's|Jetson 22pin CSI Connector|Jetson 24pin CSI Connector|' "$PREPROCESSED"
	fi

	print DTC "${DTBO##*/}"
	dtc -@ -I dts -O dtb -Wno-unit_address_vs_reg \
		-o "/boot/${DTBO##*/}" "$PREPROCESSED" 2>/dev/null

	rm -f "$PREPROCESSED"

	print INSTALL "/boot/${DTBO##*/}"
done
